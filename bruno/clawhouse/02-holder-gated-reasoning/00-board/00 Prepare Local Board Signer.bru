meta {
  name: 00 Prepare Local Board Signer
  type: http
  seq: 0
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

script:pre-request {
  const { KeyPair, keyToImplicitAddress } = require("@near-js/crypto");

  function value(name, fallback) {
    return bru.getVar(name) || bru.getEnvVar(name) || bru.getCollectionVar(name) || fallback;
  }

  function requireLocalDev() {
    const baseUrl = String(value("base_url", ""));
    if (String(value("local_runtime_only", "")) !== "true") {
      throw new Error("local_runtime_only must be true for this collection.");
    }
    if (!/^http:\/\/(127\.0\.0\.1|localhost)(:\d+)?\b/.test(baseUrl)) {
      throw new Error("This collection is locked to local runtime URLs.");
    }
  }

  requireLocalDev();

  const keyPair = KeyPair.fromRandom("ed25519");
  const publicKey = keyPair.getPublicKey();
  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  const boardPrefix = String(value("ledger_board_prefix", "bruno-holder-board"));
  const agentId = String(value("ledger_agent_id", value("agent_id", "regdgen.testnet")));
  const walletAddress = keyToImplicitAddress(publicKey);

  bru.setVar("ledger_agent_id", agentId);
  bru.setVar("ledger_board_id", `${boardPrefix}-${runId}`);
  bru.setVar("ledger_wallet_address", walletAddress);
  bru.setVar("ledger_wallet_secret_key", keyPair.toString());
  bru.setVar("ledger_wallet_public_key", publicKey.toString());
  bru.setVar("ledger_agent_public_key", publicKey.toString());
}

tests {
  test("local board signer is generated inside Bruno", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.ok).to.equal(true);
    expect(bru.getVar("ledger_board_id")).to.be.a("string");
    expect(bru.getVar("ledger_wallet_address")).to.match(/^[a-f0-9]{64}$/);
    expect(bru.getVar("ledger_wallet_secret_key")).to.match(/^ed25519:/);
    expect(bru.getVar("ledger_wallet_public_key")).to.match(/^ed25519:/);
    expect(bru.getVar("ledger_agent_public_key")).to.match(/^ed25519:/);
  });
}
