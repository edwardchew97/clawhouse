meta {
  name: 02 Read Onboarding Paper Account
  type: http
  seq: 2
}

get {
  url: {{base_url}}/paper/accounts/{{onboarding_paper_account_id}}
  body: none
  auth: none
}

script:pre-request {
  function value(name, fallback) {
    return bru.getVar(name) || bru.getEnvVar(name) || bru.getCollectionVar(name) || fallback;
  }

  function requireLocalDev() {
    const baseUrl = String(value("base_url", ""));
    if (String(value("local_runtime_only", "")) !== "true") {
      throw new Error("local_runtime_only must be true for this collection.");
    }
    if (!/^http:\/\/(127\.0\.0\.1|localhost)(:\d+)?\b/.test(baseUrl)) {
      throw new Error("This collection is locked to local runtime URLs.");
    }
  }

  requireLocalDev();
  const accountId = String(value("onboarding_paper_account_id", ""));
  if (!accountId) throw new Error("Missing onboarding_paper_account_id. Run Register Creator Onboarding first.");
  req.setUrl(`${value("base_url", "http://127.0.0.1:4321")}/paper/accounts/${accountId}`);
}

tests {
  test("onboarding paper account readback is real backend state", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.ok).to.equal(true);
    expect(body.account.id).to.equal(bru.getVar("onboarding_paper_account_id"));
    expect(body.account.agent_id).to.equal(bru.getVar("onboarding_agent_id"));
    expect(body.account.agent_public_key).to.equal(bru.getVar("onboarding_agent_public_key"));
    expect(body.account.status).to.equal("active");
  });
}
