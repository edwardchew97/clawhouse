meta {
  name: 01 Create Paper Account
  type: http
  seq: 1
}

post {
  url: {{base_url}}/paper/accounts
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {}
}

script:pre-request {
  const crypto = require("crypto");
  const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

  function requireLocalDev() {
    const baseUrl = String(bru.getEnvVar("base_url") || "");
    if (String(bru.getEnvVar("local_runtime_only")) !== "true") {
      throw new Error("local_runtime_only must be true for this collection.");
    }
    if (!/^http:\/\/(127\.0\.0\.1|localhost)(:\d+)?\b/.test(baseUrl)) {
      throw new Error("This collection is locked to local runtime URLs.");
    }
  }

  function secret(name, processName) {
    const value = bru.getEnvVar(name) || bru.getProcessEnv(processName);
    if (!value) throw new Error(`Missing ${name}. Set ${processName} in the collection .env file or Bruno secret environment.`);
    return String(value);
  }

  function base58Decode(value) {
    const bytes = [0];
    for (const char of value) {
      const index = alphabet.indexOf(char);
      if (index < 0) throw new Error("Invalid base58 character in signer key.");
      let carry = index;
      for (let i = 0; i < bytes.length; i += 1) {
        carry += bytes[i] * 58;
        bytes[i] = carry & 0xff;
        carry >>= 8;
      }
      while (carry > 0) {
        bytes.push(carry & 0xff);
        carry >>= 8;
      }
    }
    for (const char of value) {
      if (char === "1") bytes.push(0);
      else break;
    }
    return Uint8Array.from(bytes.reverse());
  }

  function base58Encode(bytes) {
    const digits = [0];
    for (const byte of bytes) {
      let carry = byte;
      for (let i = 0; i < digits.length; i += 1) {
        carry += digits[i] << 8;
        digits[i] = carry % 58;
        carry = Math.floor(carry / 58);
      }
      while (carry > 0) {
        digits.push(carry % 58);
        carry = Math.floor(carry / 58);
      }
    }
    let leadingZeroes = 0;
    for (const byte of bytes) {
      if (byte === 0) leadingZeroes += 1;
      else break;
    }
    return "1".repeat(leadingZeroes) + digits.reverse().map((digit) => alphabet[digit]).join("");
  }

  function publicKeyFromPrivateKey(secretKey) {
    const raw = secretKey.replace(/^ed25519:/, "");
    const decoded = base58Decode(raw);
    if (decoded.length !== 64) {
      throw new Error("Expected a NEAR ed25519 private key with 64 decoded bytes.");
    }
    return `ed25519:${base58Encode(decoded.slice(32))}`;
  }

  requireLocalDev();
  const adminToken = secret("admin_token", "AGENT_BOARD_LEDGER_ADMIN_TOKEN");
  const signerPrivateKey = secret("paper_signer_private_key", "PAPER_SIGNER_PRIVATE_KEY");
  const runId = `${Date.now()}-${crypto.randomUUID().slice(0, 8)}`;
  const accountPrefix = String(bru.getEnvVar("paper_account_prefix") || "local-paper");
  const paperAccountId = `${accountPrefix}-${runId}`;
  const agentId = String(bru.getEnvVar("agent_id") || "regdgen.testnet");
  const coin = String(bru.getEnvVar("coin") || "BTC").toUpperCase();
  const startingBalanceUsd = Number(bru.getEnvVar("starting_balance_usd") || 10000);

  bru.setVar("paper_account_id", paperAccountId);
  bru.setVar("agent_id", agentId);
  bru.setVar("paper_agent_public_key", publicKeyFromPrivateKey(signerPrivateKey));

  req.setHeader("authorization", `Bearer ${adminToken}`);
  req.setBody({
    paper_account_id: paperAccountId,
    agent_id: agentId,
    agent_public_key: bru.getVar("paper_agent_public_key"),
    starting_balance_usd: startingBalanceUsd,
    allowed_markets: [coin],
    metadata: {
      source: "bruno-local-dev",
      signer_account_id: agentId,
      live_market_data_required: true
    }
  });
}

script:post-response {
  const body = res.getBody();
  if (body && body.account && body.account.id) {
    bru.setVar("paper_account_id", body.account.id);
    bru.setVar("agent_id", body.account.agent_id);
    bru.setVar("paper_agent_public_key", body.account.agent_public_key);
  }
}

tests {
  test("paper account is created with wallet public key", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.ok).to.equal(true);
    expect(body.account.id).to.equal(bru.getVar("paper_account_id"));
    expect(body.account.agent_id).to.equal(bru.getVar("agent_id"));
    expect(body.account.agent_public_key).to.equal(bru.getVar("paper_agent_public_key"));
  });
}
