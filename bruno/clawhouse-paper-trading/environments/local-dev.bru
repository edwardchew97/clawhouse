vars {
  base_url: http://127.0.0.1:4321
  local_runtime_only: true
  admin_token: {{process.env.AGENT_BOARD_LEDGER_ADMIN_TOKEN}}
  paper_signer_private_key: {{process.env.PAPER_SIGNER_PRIVATE_KEY}}
  agent_id: regdgen.testnet
  paper_account_prefix: regdgen-local-paper
  starting_balance_usd: 10000
  coin: BTC
  order_size: 0.0001
  leverage: 2
  max_slippage_bps: 100
  paper_order_reason: Bruno local dev signed paper order using live Hyperliquid data.
}

vars:secret [
  admin_token,
  paper_signer_private_key
]
