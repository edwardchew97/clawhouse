meta {
  name: 03 Replay Last Paper Order
  type: http
  seq: 3
}

get {
  url: {{base_url}}/paper/orders/{{last_order_id}}/replay
  body: none
  auth: none
}

script:pre-request {
  function value(name, fallback) {
    return bru.getVar(name) || bru.getEnvVar(name) || bru.getCollectionVar(name) || fallback;
  }

  const orderId = value("last_order_id", "");
  if (!orderId) throw new Error("Missing last_order_id. Run Submit Signed IOC Paper Order first.");
  req.setUrl(`${value("base_url", "http://127.0.0.1:4321")}/paper/orders/${orderId}/replay`);
}

tests {
  test("replay has stored order, market snapshot, and audit proof", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.ok).to.equal(true);
    expect(body.replay.order.id).to.equal(bru.getVar("last_order_id"));
    expect(body.replay.market_snapshot.source).to.equal("hyperliquid");
    expect(body.replay.audit.length).to.be.greaterThan(0);
  });
}
