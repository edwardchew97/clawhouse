meta {
  name: 04 Run Paper Risk Check
  type: http
  seq: 4
}

post {
  url: {{base_url}}/paper/accounts/{{paper_account_id}}/risk-check
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {}
}

script:pre-request {
  function value(name, fallback) {
    return bru.getVar(name) || bru.getEnvVar(name) || bru.getCollectionVar(name) || fallback;
  }

  const adminToken = value("admin_token", bru.getProcessEnv("AGENT_BOARD_LEDGER_ADMIN_TOKEN"));
  const accountId = value("paper_account_id", "");
  if (!accountId) throw new Error("Missing paper_account_id. Run Create Paper Account first.");
  req.setUrl(`${value("base_url", "http://127.0.0.1:4321")}/paper/accounts/${accountId}/risk-check`);
  if (adminToken) req.setHeader("authorization", `Bearer ${adminToken}`);
  req.setHeader("x-clawhouse-bruno-gold-mode", "true");
}

tests {
  test("risk check writes/readbacks real risk state", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.ok).to.equal(true);
    expect(body.account.id).to.equal(bru.getVar("paper_account_id"));
    expect(body.risk.risk.paper_account_id).to.equal(bru.getVar("paper_account_id"));
  });
}
