meta {
  name: 04 Run Paper Risk Check
  type: http
  seq: 4
}

post {
  url: {{base_url}}/paper/accounts/{{paper_account_id}}/risk-check
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {}
}

script:pre-request {
  const adminToken = bru.getEnvVar("admin_token") || bru.getProcessEnv("AGENT_BOARD_LEDGER_ADMIN_TOKEN");
  const accountId = bru.getVar("paper_account_id") || bru.getEnvVar("paper_account_id");
  if (!adminToken) throw new Error("Missing admin_token. Set AGENT_BOARD_LEDGER_ADMIN_TOKEN.");
  if (!accountId) throw new Error("Missing paper_account_id. Run Create Paper Account first.");
  req.setUrl(`${bru.getEnvVar("base_url")}/paper/accounts/${accountId}/risk-check`);
  req.setHeader("authorization", `Bearer ${adminToken}`);
}

tests {
  test("risk check writes/readbacks real risk state", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.ok).to.equal(true);
    expect(body.account.id).to.equal(bru.getVar("paper_account_id"));
    expect(body.risk.risk.paper_account_id).to.equal(bru.getVar("paper_account_id"));
  });
}
