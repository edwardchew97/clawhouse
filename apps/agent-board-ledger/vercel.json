{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun scripts/vercel-build.ts",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/ledger?ledgerPath=/health"
    },
    {
      "source": "/boards/:path*",
      "destination": "/api/ledger?ledgerPath=/boards/:path*"
    },
    {
      "source": "/paper/:path*",
      "destination": "/api/ledger?ledgerPath=/paper/:path*"
    },
    {
      "source": "/creator-onboarding/:path*",
      "destination": "/api/ledger?ledgerPath=/creator-onboarding/:path*"
    },
    {
      "source": "/key-market/:path*",
      "destination": "/api/ledger?ledgerPath=/key-market/:path*"
    },
    {
      "source": "/cron/:path*",
      "destination": "/api/ledger?ledgerPath=/cron/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ]
}
