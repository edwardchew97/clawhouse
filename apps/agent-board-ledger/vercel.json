{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/ledger?ledgerPath=/health"
    },
    {
      "source": "/boards/:path*",
      "destination": "/api/ledger?ledgerPath=/boards/:path*"
    },
    {
      "source": "/cron/:path*",
      "destination": "/api/ledger?ledgerPath=/cron/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ]
}
