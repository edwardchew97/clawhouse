{
  "name": "ClawHouse Season 0 Acceptance",
  "version": "0.1.0",
  "flows": [
    {
      "id": "creator-onboarding",
      "name": "Creator Onboarding",
      "purpose": "Verify draft submission, approval-link creation, and deployment boundary.",
      "steps": [
        {
          "id": "creator.submitDraft",
          "name": "Submit Agent Draft",
          "type": "http",
          "method": "POST",
          "url": "{{baseUrl}}/api/creator/drafts",
          "headers": {
            "content-type": "application/json",
            "authorization": "Bearer {{apiToken}}"
          },
          "body": {
            "creatorHandle": "{{creatorHandle}}",
            "agentName": "{{agentName}}",
            "strategyPrompt": "{{strategyPrompt}}",
            "risk": {
              "maxDrawdownPct": "{{maxDrawdownPct}}",
              "allowedMarkets": "{{allowedMarkets}}"
            }
          },
          "runningNotes": [
            "Sending the draft payload to the creator API.",
            "Waiting for the backend to store the draft and return identifiers.",
            "Extracting draftId, capsuleHash, and approvalUrl for later steps."
          ],
          "inputs": {
            "creatorHandle": "@grandmaquant",
            "agentName": "Grandma Quant",
            "strategyPrompt": "Rotate between BTC, ETH, and NEAR with conservative risk commentary.",
            "maxDrawdownPct": "5",
            "allowedMarkets": "BTC,ETH,NEAR"
          },
          "setVars": {
            "draftId": "response.json.draftId",
            "capsuleHash": "response.json.capsuleHash",
            "approvalUrl": "response.json.approvalUrl"
          }
        },
        {
          "id": "creator.fetchDraft",
          "name": "Fetch Pending Draft",
          "type": "http",
          "method": "GET",
          "url": "{{baseUrl}}/api/creator/drafts/{{draftId}}",
          "headers": {
            "authorization": "Bearer {{apiToken}}"
          },
          "runningNotes": [
            "Fetching the saved draft from the backend.",
            "Checking that the draft id from the previous step resolves to real data."
          ],
          "inputs": {},
          "setVars": {}
        },
        {
          "id": "creator.approveDraft",
          "name": "Approve Draft For Deployment",
          "type": "http",
          "method": "POST",
          "url": "{{baseUrl}}/api/creator/drafts/{{draftId}}/approve",
          "headers": {
            "content-type": "application/json",
            "authorization": "Bearer {{apiToken}}"
          },
          "body": {
            "approvedCapsuleHash": "{{capsuleHash}}",
            "reviewer": "{{reviewer}}"
          },
          "runningNotes": [
            "Sending the approval decision to the creator backend.",
            "Waiting for the backend to create a deployment request.",
            "Extracting deployRequestId for follow-up verification."
          ],
          "inputs": {},
          "setVars": {
            "deployRequestId": "response.json.deployRequestId"
          }
        }
      ]
    },
    {
      "id": "key-market",
      "name": "NEAR Key Market",
      "purpose": "Verify Scope V0 contract behavior through local scripts and NEAR RPC state reads.",
      "steps": [
        {
          "id": "key.create",
          "name": "Create Agent Key Market",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "create",
            "{{agentId}}",
            "{{agentName}}",
            "{{metadataUri}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Checking NEAR testnet to see whether this agent key market already exists.",
            "If it is new, signing a create transaction with the test user account.",
            "Broadcasting the transaction to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash and the created market state from the transaction result."
          ],
          "inputs": {
            "agentId": "terminal_chad",
            "agentName": "Terminal Chad",
            "metadataUri": "ipfs://terminal-chad",
            "STORAGE_DEPOSIT": "1"
          },
          "setVars": {
            "agentId": "response.json.agentId",
            "createTxHash": "response.json.txHash"
          }
        },
        {
          "id": "key.quoteBuy",
          "name": "Quote Buy",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the bonding-curve price, fees, and max buy cost."
          ],
          "inputs": {
            "keyAmount": "1"
          },
          "setVars": {
            "keyAmount": "response.json.amount",
            "buyMaxPriceNear": "response.json.total_cost_near",
            "buyQuoteYocto": "response.json.total_cost"
          }
        },
        {
          "id": "key.buy",
          "name": "Buy Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{buyMaxPriceNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as max_price protection.",
            "Signing a buy transaction with the test user account.",
            "Attaching NEAR for the key price, fees, and storage deposit.",
            "Waiting for NEAR testnet to return the raw transaction outcome and txHash."
          ],
          "inputs": {
            "STORAGE_DEPOSIT": "0.2"
          },
          "setVars": {
            "buyTxHash": "response.json.txHash",
            "supplyAfterBuy": "response.json.result.supply_after",
            "holderBalanceAfterBuy": "response.json.result.trader_balance_after",
            "reserveAfterBuyYocto": "response.json.result.reserve_after"
          }
        },
        {
          "id": "key.stateAfterBuy",
          "name": "Read Contract State After Buy",
          "type": "near-view",
          "contractId": "{{contractId}}",
          "methodName": "get_state",
          "args": {
            "agent_id": "{{agentId}}",
            "holder_id": "{{testUserAccountId}}"
          },
          "runningNotes": [
            "Calling NEAR RPC view state directly; this does not sign or send a transaction.",
            "Reading the agent market state and holder balance after the buy.",
            "Extracting supply, reserve, and holder balance for comparison."
          ],
          "inputs": {},
          "setVars": {
            "keySupply": "response.json.agent.supply",
            "reserveYocto": "response.json.agent.reserve",
            "holderBalance": "response.json.holder_balance"
          }
        },
        {
          "id": "key.quoteSell",
          "name": "Quote Sell",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the expected sell payout and min_payout guard."
          ],
          "inputs": {},
          "setVars": {
            "minPayoutNear": "response.json.payout_near",
            "sellQuoteYocto": "response.json.payout"
          }
        },
        {
          "id": "key.sell",
          "name": "Sell Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{minPayoutNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as min_payout protection.",
            "Signing a sell transaction with the test user account.",
            "Broadcasting the sell to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash, updated supply, holder balance, and reserve."
          ],
          "inputs": {},
          "setVars": {
            "sellTxHash": "response.json.txHash",
            "supplyAfterSell": "response.json.result.supply_after",
            "holderBalanceAfterSell": "response.json.result.trader_balance_after",
            "reserveAfterSellYocto": "response.json.result.reserve_after"
          }
        }
      ]
    },
    {
      "id": "ironclaw",
      "name": "IronClaw Runtime",
      "purpose": "Verify a deployed/self-hosted IronClaw instance accepts a real webhook message.",
      "steps": [
        {
          "id": "ironclaw.webhook",
          "name": "Send Webhook Message",
          "type": "http",
          "method": "POST",
          "url": "{{ironclawWebhookUrl}}",
          "headers": {
            "content-type": "application/json",
            "authorization": "Bearer {{ironclawWebhookSecret}}"
          },
          "body": {
            "user_id": "{{holderId}}",
            "message": "{{agentMessage}}"
          },
          "runningNotes": [
            "Sending a real webhook request to the configured IronClaw endpoint.",
            "Waiting for the service to accept the message and create a job.",
            "Extracting the job id for the result fetch step."
          ],
          "inputs": {
            "holderId": "holder-36",
            "agentMessage": "Give a one-paragraph room update for the latest key-market move."
          },
          "setVars": {
            "ironclawJobId": "response.json.job_id"
          }
        },
        {
          "id": "ironclaw.job",
          "name": "Fetch Job Result",
          "type": "http",
          "method": "GET",
          "url": "{{ironclawBaseUrl}}/jobs/{{ironclawJobId}}",
          "headers": {
            "authorization": "Bearer {{ironclawWebhookSecret}}"
          },
          "runningNotes": [
            "Fetching the IronClaw job created by the webhook step.",
            "Waiting for the backend to return the current job status or result."
          ],
          "inputs": {},
          "setVars": {}
        }
      ]
    },
    {
      "id": "outlayer-policy",
      "name": "OutLayer Policy",
      "purpose": "Verify the policy checker denies invalid trade proposals and allows valid ones.",
      "steps": [
        {
          "id": "outlayer.check",
          "name": "Run Policy Checker Script",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "policy:check",
            "--asset",
            "{{asset}}",
            "--notional-usd",
            "{{notionalUsd}}",
            "--max-position-usd",
            "{{maxPositionUsd}}",
            "--leverage",
            "{{leverage}}"
          ],
          "cwd": "{{repoRoot}}/outlayer-policy-checker",
          "runningNotes": [
            "Running the local OutLayer policy checker script.",
            "Evaluating the requested notional, max position, asset, and leverage inputs.",
            "Returning the allow/deny decision as structured JSON."
          ],
          "inputs": {
            "asset": "BTC",
            "notionalUsd": "80",
            "maxPositionUsd": "100",
            "leverage": "none"
          },
          "setVars": {
            "policyDecision": "response.json.allowed"
          }
        }
      ]
    }
  ]
}
