{
  "name": "ClawHouse Season 0 Acceptance",
  "version": "0.1.0",
  "flows": [
    {
      "id": "key-market",
      "name": "NEAR Key Market",
      "purpose": "Verify Scope V0 contract behavior through local scripts and NEAR RPC state reads.",
      "steps": [
        {
          "id": "key.create",
          "name": "Create Agent Key Market",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "create",
            "{{agentId}}",
            "{{agentName}}",
            "{{metadataUri}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Checking NEAR testnet to see whether this agent key market already exists.",
            "If it is new, signing a create transaction with the test user account.",
            "Broadcasting the transaction to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash and the created market state from the transaction result."
          ],
          "inputs": {
            "agentId": "terminal_chad",
            "agentName": "Terminal Chad",
            "metadataUri": "ipfs://terminal-chad",
            "STORAGE_DEPOSIT": "1"
          },
          "setVars": {
            "agentId": "response.json.agentId",
            "createTxHash": "response.json.txHash"
          }
        },
        {
          "id": "key.quoteBuy",
          "name": "Quote Buy",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the bonding-curve price, fees, and max buy cost."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "setVars": {
            "keyAmount": "response.json.amount",
            "buyMaxPriceNear": "response.json.total_cost_near",
            "buyQuoteYocto": "response.json.total_cost"
          }
        },
        {
          "id": "key.buy",
          "name": "Buy Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{buyMaxPriceNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as max_price protection.",
            "Signing a buy transaction with the test user account.",
            "Attaching NEAR for the key price, fees, and storage deposit.",
            "Waiting for NEAR testnet to return the raw transaction outcome and txHash."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1",
            "buyMaxPriceNear": "",
            "STORAGE_DEPOSIT": "0.2"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "autoFill": [
            {
              "input": "buyMaxPriceNear",
              "stepId": "key.quoteBuy",
              "source": "response.json.total_cost_near",
              "requiredInputs": [
                "agentId",
                "keyAmount"
              ]
            }
          ],
          "setVars": {
            "buyTxHash": "response.json.txHash",
            "supplyAfterBuy": "response.json.result.supply_after",
            "holderBalanceAfterBuy": "response.json.result.trader_balance_after",
            "reserveAfterBuyYocto": "response.json.result.reserve_after"
          }
        },
        {
          "id": "key.stateAfterBuy",
          "name": "Read Contract State After Buy",
          "type": "near-view",
          "contractId": "{{contractId}}",
          "methodName": "get_state",
          "args": {
            "agent_id": "{{agentId}}",
            "holder_id": "{{testUserAccountId}}"
          },
          "runningNotes": [
            "Calling NEAR RPC view state directly; this does not sign or send a transaction.",
            "Reading the agent market state and holder balance after the buy.",
            "Extracting supply, reserve, and holder balance for comparison."
          ],
          "inputs": {
            "agentId": "",
            "testUserAccountId": ""
          },
          "setVars": {
            "keySupply": "response.json.agent.supply",
            "reserveYocto": "response.json.agent.reserve",
            "holderBalance": "response.json.holder_balance"
          }
        },
        {
          "id": "key.quoteSell",
          "name": "Quote Sell",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the expected sell payout and min_payout guard."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "setVars": {
            "minPayoutNear": "response.json.payout_near",
            "sellQuoteYocto": "response.json.payout"
          }
        },
        {
          "id": "key.sell",
          "name": "Sell Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{minPayoutNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as min_payout protection.",
            "Signing a sell transaction with the test user account.",
            "Broadcasting the sell to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash, updated supply, holder balance, and reserve."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1",
            "minPayoutNear": ""
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "autoFill": [
            {
              "input": "minPayoutNear",
              "stepId": "key.quoteSell",
              "source": "response.json.payout_near",
              "requiredInputs": [
                "agentId",
                "keyAmount"
              ]
            }
          ],
          "setVars": {
            "sellTxHash": "response.json.txHash",
            "supplyAfterSell": "response.json.result.supply_after",
            "holderBalanceAfterSell": "response.json.result.trader_balance_after",
            "reserveAfterSellYocto": "response.json.result.reserve_after"
          }
        }
      ]
    },
    {
      "id": "near-wallet-onboarding",
      "name": "NEAR Wallet Onboarding",
      "purpose": "Verify the local NEAR wallet tool creates a test wallet artifact, exposes public metadata, refuses duplicate overwrite, and keeps private key material out of Workbench responses.",
      "steps": [
        {
          "id": "wallet.generate",
          "name": "Generate Test Wallet",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "generate",
            "--",
            "--out",
            "{{repoRoot}}/{{walletArtifactRelativePath}}",
            "--overwrite"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Running the allowlisted local NEAR wallet generator.",
            "Writing the generated test wallet artifact under work/acceptance-workbench.",
            "Returning only public wallet metadata to the Workbench response."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "setVars": {
            "walletArtifactRelativePath": "inputs.walletArtifactRelativePath",
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        },
        {
          "id": "wallet.inspectPublic",
          "name": "Inspect Public Metadata",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "inspect",
            "--",
            "--key-file",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Reading the generated wallet artifact through the local wallet tool.",
            "Requesting the public inspect view only.",
            "Extracting walletAddress, publicKey, and keyId for later checks."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        },
        {
          "id": "wallet.duplicateRefusesOverwrite",
          "name": "Duplicate Generation Refuses Overwrite",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "generate",
            "--",
            "--out",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "expectedExitCode": 1,
          "expectedOutputIncludes": "overwrite",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Running the same generator against the existing wallet artifact.",
            "Expecting the tool to refuse overwrite with exit code 1 and output that mentions overwrite.",
            "Confirming the refusal text is visible without private key material."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {}
        },
        {
          "id": "wallet.inspectPublicAfterDuplicate",
          "name": "Inspect Public Metadata After Refusal",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "inspect",
            "--",
            "--key-file",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Reading the wallet artifact after the duplicate-generation refusal.",
            "Checking that the artifact still exposes the same public metadata.",
            "If privateKey or secretKey appears as a redacted field, the public inspect path still leaked a private field name."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        }
      ]
    },
    {
      "id": "agent-board-ledger",
      "name": "Agent Board Ledger",
      "purpose": "Expose and verify the V0 ledger HTTP API for board registration, observations, accounting evidence, cron reconciliation, portfolio, PnL, read access, wallet-signed events, and full script-backed flows through the real local service.",
      "steps": [
        {
          "id": "ledger.apiHealth",
          "name": "GET /health",
          "type": "http",
          "method": "GET",
          "url": "{{ledgerBaseUrl}}/health",
          "runningNotes": [
            "Calling the real Agent Board Ledger /health endpoint.",
            "Use this first to confirm the local backend is running and connected to Neon/Postgres."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321"
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
            "ledgerHealthDb": "response.json.json.db"
          }
        },
        {
          "id": "ledger.apiCreateBoard",
          "name": "POST /boards",
          "type": "http",
          "method": "POST",
          "url": "{{ledgerBaseUrl}}/boards",
          "headers": {
            "content-type": "application/json",
            "authorization": "{{ledgerAuthorizationHeader}}"
          },
          "body": {
            "board_id": "{{ledgerBoardId}}",
            "agent_id": "{{ledgerAgentId}}",
            "wallet_address": "{{ledgerWalletAddress}}",
            "public_key": "{{ledgerPublicKey}}",
            "starting_value_usd": "{{ledgerStartingValueUsd}}",
            "base_currency": "USD",
            "public_status": "active",
            "visibility_mode": "{{ledgerVisibilityMode}}"
          },
          "runningNotes": [
            "Calling the real POST /boards backend API.",
            "ledgerAuthorizationHeader must be formatted as Bearer <AGENT_BOARD_LEDGER_ADMIN_TOKEN>.",
            "Leave ledgerBoardId empty if you want the backend to generate an id.",
            "The returned board id is stored as ledgerBoardId for the later API calls."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerAuthorizationHeader": "",
            "ledgerBoardId": "",
            "ledgerAgentId": "ironclaw-api-workbench",
            "ledgerWalletAddress": "ledger-api-wallet.testnet",
            "ledgerPublicKey": "ed25519:ledger-api-public-key",
            "ledgerStartingValueUsd": "100",
            "ledgerVisibilityMode": "public"
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl",
            "ledgerAgentId",
            "ledgerWalletAddress",
            "ledgerPublicKey",
            "ledgerStartingValueUsd",
            "ledgerVisibilityMode"
          ],
          "setVars": {
            "ledgerBoardId": "response.json.json.board.id",
            "ledgerAgentId": "response.json.json.board.agent_id",
            "ledgerWalletAddress": "response.json.json.board.wallet_address",
            "ledgerPublicKey": "response.json.json.board.public_key"
          }
        },
        {
          "id": "ledger.apiGetBoard",
          "name": "GET /boards/:id",
          "type": "http",
          "method": "GET",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}",
          "headers": {
            "x-clawhouse-read-token": "{{ledgerReadToken}}"
          },
          "runningNotes": [
            "Reading a board through the real GET /boards/:id API.",
            "Public boards do not need a read token; holder-gated boards need ledgerReadToken."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerBoardId": "",
            "ledgerReadToken": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
            "ledgerBoardId": "response.json.json.id",
            "ledgerWalletAddress": "response.json.json.wallet_address"
          }
        },
        {
          "id": "ledger.apiCreateObservation",
          "name": "POST /boards/:id/observations",
          "type": "http",
          "method": "POST",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/observations",
          "headers": {
            "content-type": "application/json",
            "authorization": "{{ledgerAuthorizationHeader}}"
          },
          "body": {
            "wallet_address": "{{ledgerWalletAddress}}",
            "current_value_usd": "{{ledgerCurrentValueUsd}}",
            "topup_usd": "{{ledgerTopupUsd}}",
            "withdrawal_usd": "{{ledgerWithdrawalUsd}}",
            "client_event_id": "{{ledgerClientEventId}}",
            "tx_hash": "{{ledgerTxHash}}",
            "intent_id": "{{ledgerIntentId}}",
            "status_claim": "observed_on_wallet",
            "asset_in": "{{ledgerAssetIn}}",
            "amount_in": "{{ledgerAmountIn}}",
            "asset_out": "{{ledgerAssetOut}}",
            "amount_out": "{{ledgerAmountOut}}",
            "metadata": {
              "source": "acceptance-workbench-api"
            }
          },
          "runningNotes": [
            "Calling the real service-authorized observation API.",
            "This is how the backend records an observed wallet/portfolio state before cron calculates PnL.",
            "ledgerAuthorizationHeader must be formatted as Bearer <AGENT_BOARD_LEDGER_ADMIN_TOKEN>."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerAuthorizationHeader": "",
            "ledgerBoardId": "",
            "ledgerWalletAddress": "",
            "ledgerCurrentValueUsd": "112",
            "ledgerTopupUsd": "0",
            "ledgerWithdrawalUsd": "0",
            "ledgerClientEventId": "",
            "ledgerTxHash": "",
            "ledgerIntentId": "",
            "ledgerAssetIn": "USDC",
            "ledgerAmountIn": "25",
            "ledgerAssetOut": "NEAR",
            "ledgerAmountOut": "10"
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl",
            "ledgerCurrentValueUsd",
            "ledgerTopupUsd",
            "ledgerWithdrawalUsd",
            "ledgerAssetIn",
            "ledgerAmountIn",
            "ledgerAssetOut",
            "ledgerAmountOut"
          ],
          "setVars": {
            "ledgerObservationId": "response.json.json.observation.id",
            "ledgerObservedAt": "response.json.json.observation.observed_at",
            "ledgerClientEventId": "response.json.json.observation.client_event_id",
            "ledgerTxHash": "response.json.json.observation.tx_hash",
            "ledgerIntentId": "response.json.json.observation.intent_id"
          }
        },
        {
          "id": "ledger.apiCreatePrice",
          "name": "POST /boards/:id/prices",
          "type": "http",
          "method": "POST",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/prices",
          "headers": {
            "content-type": "application/json",
            "authorization": "{{ledgerAuthorizationHeader}}"
          },
          "body": {
            "asset_id": "{{ledgerPriceAssetId}}",
            "asset_symbol": "{{ledgerPriceAssetSymbol}}",
            "price_usd": "{{ledgerPriceUsd}}",
            "price_source": "{{ledgerPriceSource}}",
            "observed_at": "{{ledgerObservedAt}}"
          },
          "runningNotes": [
            "Calling the real price snapshot API.",
            "Use this before cron when you want a PnL snapshot to link to explicit pricing evidence."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerAuthorizationHeader": "",
            "ledgerBoardId": "",
            "ledgerPriceAssetId": "native:near",
            "ledgerPriceAssetSymbol": "NEAR",
            "ledgerPriceUsd": "2",
            "ledgerPriceSource": "acceptance-workbench-api",
            "ledgerObservedAt": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl",
            "ledgerPriceAssetId",
            "ledgerPriceAssetSymbol",
            "ledgerPriceUsd",
            "ledgerPriceSource"
          ],
          "setVars": {
            "ledgerPriceSnapshotId": "response.json.json.prices.0.id"
          }
        },
        {
          "id": "ledger.apiCreateBalanceChange",
          "name": "POST /boards/:id/balance-changes",
          "type": "http",
          "method": "POST",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/balance-changes",
          "headers": {
            "content-type": "application/json",
            "authorization": "{{ledgerAuthorizationHeader}}"
          },
          "body": {
            "asset_id": "{{ledgerBalanceAssetId}}",
            "asset_symbol": "{{ledgerBalanceAssetSymbol}}",
            "normalized_amount": "{{ledgerNormalizedAmount}}",
            "delta_amount": "{{ledgerDeltaAmount}}",
            "delta_value_usd": "{{ledgerDeltaValueUsd}}",
            "change_type": "{{ledgerChangeType}}",
            "source_observation_id": "{{ledgerObservationId}}",
            "tx_hash": "{{ledgerTxHash}}",
            "intent_id": "{{ledgerIntentId}}",
            "metadata": {
              "source": "acceptance-workbench-api"
            }
          },
          "runningNotes": [
            "Calling the real balance-change API.",
            "This records accounting evidence for the wallet and can link back to an observation, tx hash, or intent id."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerAuthorizationHeader": "",
            "ledgerBoardId": "",
            "ledgerBalanceAssetId": "native:near",
            "ledgerBalanceAssetSymbol": "NEAR",
            "ledgerNormalizedAmount": "56",
            "ledgerDeltaAmount": "6",
            "ledgerDeltaValueUsd": "12",
            "ledgerChangeType": "trade",
            "ledgerObservationId": "",
            "ledgerTxHash": "",
            "ledgerIntentId": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl",
            "ledgerBalanceAssetId",
            "ledgerBalanceAssetSymbol",
            "ledgerNormalizedAmount",
            "ledgerDeltaAmount",
            "ledgerDeltaValueUsd",
            "ledgerChangeType"
          ],
          "setVars": {
            "ledgerBalanceChangeId": "response.json.json.balance_changes.0.id"
          }
        },
        {
          "id": "ledger.apiCronTick",
          "name": "POST /cron/tick",
          "type": "http",
          "method": "POST",
          "url": "{{ledgerBaseUrl}}/cron/tick",
          "headers": {
            "content-type": "application/json",
            "authorization": "{{ledgerAuthorizationHeader}}"
          },
          "body": {},
          "runningNotes": [
            "Calling the real cron reconciliation API.",
            "This links observed activity to events, creates holding snapshots, and calculates PnL."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerAuthorizationHeader": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
            "ledgerCronStatus": "response.json.json.status",
            "ledgerSnapshotsCreated": "response.json.json.summary.snapshotsCreated"
          }
        },
        {
          "id": "ledger.apiListEvents",
          "name": "GET /boards/:id/events",
          "type": "http",
          "method": "GET",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/events",
          "headers": {
            "x-clawhouse-read-token": "{{ledgerReadToken}}"
          },
          "runningNotes": [
            "Reading the event timeline through the real GET /boards/:id/events API.",
            "Public boards do not need a read token; holder-gated boards need ledgerReadToken."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerBoardId": "",
            "ledgerReadToken": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
            "ledgerEventId": "response.json.json.events.0.id",
            "ledgerEventCount": "response.json.json.events.length"
          }
        },
        {
          "id": "ledger.apiGetPortfolio",
          "name": "GET /boards/:id/portfolio",
          "type": "http",
          "method": "GET",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/portfolio",
          "headers": {
            "x-clawhouse-read-token": "{{ledgerReadToken}}"
          },
          "runningNotes": [
            "Reading the latest portfolio snapshot through the real GET /boards/:id/portfolio API."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerBoardId": "",
            "ledgerReadToken": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
            "ledgerHoldingSnapshotId": "response.json.json.latest.id",
            "ledgerCurrentValueUsd": "response.json.json.latest.current_value_usd"
          }
        },
        {
          "id": "ledger.apiGetPnl",
          "name": "GET /boards/:id/pnl",
          "type": "http",
          "method": "GET",
          "url": "{{ledgerBaseUrl}}/boards/{{ledgerBoardId}}/pnl",
          "headers": {
            "x-clawhouse-read-token": "{{ledgerReadToken}}"
          },
          "runningNotes": [
            "Reading the latest PnL snapshot through the real GET /boards/:id/pnl API."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerBoardId": "",
            "ledgerReadToken": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl"
          ],
          "setVars": {
