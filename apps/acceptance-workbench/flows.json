{
  "name": "ClawHouse Season 0 Acceptance",
  "version": "0.1.0",
  "flows": [
    {
      "id": "key-market",
      "name": "NEAR Key Market",
      "purpose": "Verify Scope V0 contract behavior through local scripts and NEAR RPC state reads.",
      "steps": [
        {
          "id": "key.create",
          "name": "Create Agent Key Market",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "create",
            "{{agentId}}",
            "{{agentName}}",
            "{{metadataUri}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Checking NEAR testnet to see whether this agent key market already exists.",
            "If it is new, signing a create transaction with the test user account.",
            "Broadcasting the transaction to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash and the created market state from the transaction result."
          ],
          "inputs": {
            "agentId": "terminal_chad",
            "agentName": "Terminal Chad",
            "metadataUri": "ipfs://terminal-chad",
            "STORAGE_DEPOSIT": "1"
          },
          "setVars": {
            "agentId": "response.json.agentId",
            "createTxHash": "response.json.txHash"
          }
        },
        {
          "id": "key.quoteBuy",
          "name": "Quote Buy",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the bonding-curve price, fees, and max buy cost."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "setVars": {
            "keyAmount": "response.json.amount",
            "buyMaxPriceNear": "response.json.total_cost_near",
            "buyQuoteYocto": "response.json.total_cost"
          }
        },
        {
          "id": "key.buy",
          "name": "Buy Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "buy",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{buyMaxPriceNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as max_price protection.",
            "Signing a buy transaction with the test user account.",
            "Attaching NEAR for the key price, fees, and storage deposit.",
            "Waiting for NEAR testnet to return the raw transaction outcome and txHash."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1",
            "buyMaxPriceNear": "",
            "STORAGE_DEPOSIT": "0.2"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "autoFill": [
            {
              "input": "buyMaxPriceNear",
              "stepId": "key.quoteBuy",
              "source": "response.json.total_cost_near",
              "requiredInputs": [
                "agentId",
                "keyAmount"
              ]
            }
          ],
          "setVars": {
            "buyTxHash": "response.json.txHash",
            "supplyAfterBuy": "response.json.result.supply_after",
            "holderBalanceAfterBuy": "response.json.result.trader_balance_after",
            "reserveAfterBuyYocto": "response.json.result.reserve_after"
          }
        },
        {
          "id": "key.stateAfterBuy",
          "name": "Read Contract State After Buy",
          "type": "near-view",
          "contractId": "{{contractId}}",
          "methodName": "get_state",
          "args": {
            "agent_id": "{{agentId}}",
            "holder_id": "{{testUserAccountId}}"
          },
          "runningNotes": [
            "Calling NEAR RPC view state directly; this does not sign or send a transaction.",
            "Reading the agent market state and holder balance after the buy.",
            "Extracting supply, reserve, and holder balance for comparison."
          ],
          "inputs": {
            "agentId": "",
            "testUserAccountId": ""
          },
          "setVars": {
            "keySupply": "response.json.agent.supply",
            "reserveYocto": "response.json.agent.reserve",
            "holderBalance": "response.json.holder_balance"
          }
        },
        {
          "id": "key.quoteSell",
          "name": "Quote Sell",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "quote",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Calling a NEAR view method through the local quote script.",
            "No private key, gas, or transaction is used for this quote.",
            "Calculating the expected sell payout and min_payout guard."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1"
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "setVars": {
            "minPayoutNear": "response.json.payout_near",
            "sellQuoteYocto": "response.json.payout"
          }
        },
        {
          "id": "key.sell",
          "name": "Sell Key",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "sell",
            "{{agentId}}",
            "{{keyAmount}}",
            "{{minPayoutNear}}"
          ],
          "cwd": "{{repoRoot}}/agent-key-market",
          "runningNotes": [
            "Using the previous quote as min_payout protection.",
            "Signing a sell transaction with the test user account.",
            "Broadcasting the sell to NEAR testnet and waiting for the raw outcome.",
            "Extracting txHash, updated supply, holder balance, and reserve."
          ],
          "inputs": {
            "agentId": "",
            "keyAmount": "1",
            "minPayoutNear": ""
          },
          "fillDefaultsWhenEmpty": [
            "keyAmount"
          ],
          "autoFill": [
            {
              "input": "minPayoutNear",
              "stepId": "key.quoteSell",
              "source": "response.json.payout_near",
              "requiredInputs": [
                "agentId",
                "keyAmount"
              ]
            }
          ],
          "setVars": {
            "sellTxHash": "response.json.txHash",
            "supplyAfterSell": "response.json.result.supply_after",
            "holderBalanceAfterSell": "response.json.result.trader_balance_after",
            "reserveAfterSellYocto": "response.json.result.reserve_after"
          }
        }
      ]
    },
    {
      "id": "near-wallet-onboarding",
      "name": "NEAR Wallet Onboarding",
      "purpose": "Verify the local NEAR wallet tool creates a test wallet artifact, exposes public metadata, refuses duplicate overwrite, and keeps private key material out of Workbench responses.",
      "steps": [
        {
          "id": "wallet.generate",
          "name": "Generate Test Wallet",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "generate",
            "--",
            "--out",
            "{{repoRoot}}/{{walletArtifactRelativePath}}",
            "--overwrite"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Running the allowlisted local NEAR wallet generator.",
            "Writing the generated test wallet artifact under work/acceptance-workbench.",
            "Returning only public wallet metadata to the Workbench response."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "setVars": {
            "walletArtifactRelativePath": "inputs.walletArtifactRelativePath",
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        },
        {
          "id": "wallet.inspectPublic",
          "name": "Inspect Public Metadata",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "inspect",
            "--",
            "--key-file",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Reading the generated wallet artifact through the local wallet tool.",
            "Requesting the public inspect view only.",
            "Extracting walletAddress, publicKey, and keyId for later checks."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        },
        {
          "id": "wallet.duplicateRefusesOverwrite",
          "name": "Duplicate Generation Refuses Overwrite",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "generate",
            "--",
            "--out",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "expectedExitCode": 1,
          "expectedOutputIncludes": "overwrite",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Running the same generator against the existing wallet artifact.",
            "Expecting the tool to refuse overwrite with exit code 1 and output that mentions overwrite.",
            "Confirming the refusal text is visible without private key material."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {}
        },
        {
          "id": "wallet.inspectPublicAfterDuplicate",
          "name": "Inspect Public Metadata After Refusal",
          "type": "script",
          "command": "bun",
          "args": [
            "run",
            "inspect",
            "--",
            "--key-file",
            "{{repoRoot}}/{{walletArtifactRelativePath}}"
          ],
          "cwd": "{{repoRoot}}/tools/near-wallet",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Reading the wallet artifact after the duplicate-generation refusal.",
            "Checking that the artifact still exposes the same public metadata.",
            "If privateKey or secretKey appears as a redacted field, the public inspect path still leaked a private field name."
          ],
          "inputs": {
            "walletArtifactRelativePath": "work/acceptance-workbench/near-wallet/workbench-test-wallet.json"
          },
          "fillDefaultsWhenEmpty": [
            "walletArtifactRelativePath"
          ],
          "setVars": {
            "walletAddress": "response.json.walletAddress",
            "publicKey": "response.json.publicKey",
            "keyId": "response.json.keyId"
          }
        }
      ]
    },
    {
      "id": "agent-board-ledger",
      "name": "Agent Board Ledger",
      "purpose": "Verify the V0 ledger records wallet-signed agent events, append-only attachments, wallet observations, cron reconciliation, portfolio, and PnL through the real local HTTP service.",
      "steps": [
        {
          "id": "ledger.fullFlow",
          "name": "Run Signed Ledger Flow",
          "type": "script",
          "command": "bun",
          "args": [
            "scripts/workbench-flow.ts",
            "--base-url",
            "{{ledgerBaseUrl}}",
            "--key-file",
            "{{ledgerWalletFile}}",
            "--board-id",
            "{{ledgerBoardId}}",
            "--agent-id",
            "{{ledgerAgentId}}",
            "--starting-value-usd",
            "{{ledgerStartingValueUsd}}",
            "--current-value-usd",
            "{{ledgerCurrentValueUsd}}",
            "--client-event-id",
            "{{ledgerClientEventId}}",
            "--tx-hash",
            "{{ledgerTxHash}}",
            "--intent-id",
            "{{ledgerIntentId}}"
          ],
          "cwd": "{{repoRoot}}/apps/agent-board-ledger",
          "redactPrivateKeyOutput": true,
          "forbiddenOutputIncludes": [
            "privateKey",
            "private_key",
            "secretKey",
            "secret_key",
            "mnemonic"
          ],
          "runningNotes": [
            "Calling the real local Agent Board Ledger service; the step fails if the service is not running.",
            "Creating or reusing a local Workbench wallet artifact under work/ and registering a board with its public wallet metadata.",
            "Signing the event and attachment requests with the board wallet before sending them to the Ledger HTTP API.",
            "Writing a wallet observation, running cron reconciliation, then reading events, portfolio, and PnL back from the Ledger."
          ],
          "inputs": {
            "ledgerBaseUrl": "http://127.0.0.1:4321",
            "ledgerWalletFile": "work/acceptance-workbench/agent-board-ledger/workbench-wallet.json",
            "ledgerBoardId": "",
            "ledgerAgentId": "ironclaw-workbench",
            "ledgerStartingValueUsd": "100",
            "ledgerCurrentValueUsd": "112",
            "ledgerClientEventId": "",
            "ledgerTxHash": "",
            "ledgerIntentId": ""
          },
          "fillDefaultsWhenEmpty": [
            "ledgerBaseUrl",
            "ledgerWalletFile",
            "ledgerAgentId",
            "ledgerStartingValueUsd",
            "ledgerCurrentValueUsd"
          ],
          "setVars": {
            "ledgerBoardId": "response.json.boardId",
            "ledgerWalletAddress": "response.json.wallet.walletAddress",
            "ledgerPublicKey": "response.json.wallet.publicKey",
            "ledgerClientEventId": "response.json.clientEventId",
            "ledgerTxHash": "response.json.txHash",
            "ledgerIntentId": "response.json.intentId",
            "ledgerEventId": "response.json.event.id",
            "ledgerAttachmentId": "response.json.attachment.id",
            "ledgerEventCount": "response.json.summary.eventCount",
            "ledgerAttachmentCount": "response.json.summary.attachmentCount",
            "ledgerPnlUsd": "response.json.summary.pnlUsd"
          }
        }
      ]
    }
  ]
}
