{
  "name": "clawhouse",
  "private": true,
  "type": "module",
  "scripts": {
    "clawhouse-app:dev": "cd apps/clawhouse-app && bun run dev",
    "clawhouse-app:build": "cd apps/clawhouse-app && bun run build",
    "clawhouse-app:start": "cd apps/clawhouse-app && bun run start",
    "clawhouse-app:typecheck": "cd apps/clawhouse-app && bun run typecheck",
    "local-runtime": "bun scripts/clawhouse-local-runtime.ts",
    "local-runtime:start": "bun scripts/clawhouse-local-runtime.ts start",
    "local-runtime:status": "bun scripts/clawhouse-local-runtime.ts status",
    "local-runtime:stop": "bun scripts/clawhouse-local-runtime.ts stop",
    "ledger:dev": "cd apps/agent-board-ledger && bun run dev",
    "ledger:db:migrate:neon": "cd apps/agent-board-ledger && bun run db:migrate:neon",
    "ledger:db:check:neon": "cd apps/agent-board-ledger && bun run db:check:neon",
    "ledger:test": "cd apps/agent-board-ledger && bun test",
    "ledger:typecheck": "cd apps/agent-board-ledger && bun run typecheck",
    "workbench": "bun scripts/workbench.ts",
    "workbench:once": "bun apps/acceptance-workbench/server.ts --port=4318",
    "onboarding-kit:sync": "bun scripts/sync-onboarding-kit.ts"
  }
}
